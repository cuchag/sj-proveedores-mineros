{
  "name": "sj-proveedores-mineros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:setup --silent",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/setup-db.ts --seed",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Cumplimiento de la Ley de Desarrollo Local Minero de San Juan para contratistas y proveedores",
  "engines": {
    "node": ">=20.9"
  }
}
