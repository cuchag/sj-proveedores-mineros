# Copiá este archivo como .env.local y completá los valores.

# Base de datos Postgres para producción (Supabase, Neon, Railway, etc.).
# Si se deja vacía, la app usa un Postgres embebido (PGlite) guardado en ./.data,
# ideal para desarrollo y demos sin instalar nada.
DATABASE_URL=

# Carpeta del Postgres embebido (solo si DATABASE_URL está vacía).
PGLITE_DIR=./.data/pglite
